<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <%
    const seo = theme.seo || {};
    const siteTitle = config.title || '';
    const pageTitle = page.title ? `${page.title} | ${siteTitle}` : siteTitle;
    const siteDescription = config.description || seo.default_description || '';
    const plainText = value => String(value || '')
      .replace(/<script[\s\S]*?<\/script>/gi, '')
      .replace(/<style[\s\S]*?<\/style>/gi, '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&nbsp;/g, ' ')
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, "'")
      .replace(/\s+/g, ' ')
      .trim();
    const truncate = (value, length) => {
      const text = plainText(value);
      return text.length > length ? `${text.slice(0, length - 1)}…` : text;
    };
    const absoluteUrl = value => {
      if (!value) return '';
      if (/^https?:\/\//i.test(value)) return value;
      const base = String(config.url || '').replace(/\/$/, '');
      const normalized = String(value).startsWith('/') ? String(value) : `/${value}`;
      return `${base}${normalized}`;
    };
    const firstValue = value => Array.isArray(value) ? value[0] : value;
    const firstImageMatch = String(page.content || '').match(/<img\s+[^>]*src=["']([^"']+)["']/i);
    const configuredImage = firstValue(page.thumbnail || page.cover || page.image);
    const imagePath = configuredImage || (firstImageMatch && firstImageMatch[1]) || seo.default_image || theme.favicon?.large || theme.favicon?.medium || theme.favicon?.ico;
    const imageUrl = absoluteUrl(imagePath);
    const canonicalUrl = (page.permalink || absoluteUrl(page.path || '/')).replace(/\/index\.html$/, '/');
    const description = truncate(page.description || page.excerpt || page.content || siteDescription, 160) || siteDescription;
    const isArticle = page.layout === 'post' || String(page.source || '').includes('_posts/');
    const jsonLd = isArticle ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: page.title || siteTitle,
      description,
      image: imageUrl ? [imageUrl] : undefined,
      datePublished: page.date && page.date.toISOString ? page.date.toISOString() : undefined,
      dateModified: page.updated && page.updated.toISOString ? page.updated.toISOString() : undefined,
      author: {
        '@type': 'Person',
        name: config.author || siteTitle
      },
      publisher: {
        '@type': 'Organization',
        name: siteTitle,
        logo: imageUrl ? {
          '@type': 'ImageObject',
          url: imageUrl
        } : undefined
      },
      mainEntityOfPage: canonicalUrl
    } : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteTitle,
      description,
      url: absoluteUrl('/')
    };
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= description %>">
  <link rel="canonical" href="<%- canonicalUrl %>">
  <meta property="og:type" content="<%= isArticle ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%- canonicalUrl %>">
  <meta property="og:site_name" content="<%= siteTitle %>">
  <meta property="og:locale" content="ja_JP">
  <% if (imageUrl) { %>
    <meta property="og:image" content="<%- imageUrl %>">
    <meta property="og:image:secure_url" content="<%- imageUrl %>">
    <% if (imagePath === seo.default_image && seo.default_image_width && seo.default_image_height) { %>
      <meta property="og:image:width" content="<%= seo.default_image_width %>">
      <meta property="og:image:height" content="<%= seo.default_image_height %>">
    <% } %>
  <% } %>
  <% if (isArticle) { %>
    <% if (page.date && page.date.toISOString) { %>
      <meta property="article:published_time" content="<%- page.date.toISOString() %>">
    <% } %>
    <% if (page.updated && page.updated.toISOString) { %>
      <meta property="article:modified_time" content="<%- page.updated.toISOString() %>">
    <% } %>
    <% if (page.tags && page.tags.length) { %>
      <% page.tags.each(function(tag) { %>
        <meta property="article:tag" content="<%= tag.name %>">
      <% }) %>
    <% } %>
  <% } %>
  <meta name="twitter:card" content="<%= seo.twitter_card || 'summary_large_image' %>">
  <% if (seo.twitter_site) { %>
    <meta name="twitter:site" content="<%= seo.twitter_site %>">
  <% } %>
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= description %>">
  <% if (imageUrl) { %>
    <meta name="twitter:image" content="<%- imageUrl %>">
  <% } %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script>
  <% if (theme.analytics && theme.analytics.google_measurement_id) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%- theme.analytics.google_measurement_id %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%- theme.analytics.google_measurement_id %>');
    </script>
  <% } %>

  <!-- Favicon 配置 -->
  <% if (theme.favicon) { %>
    <% if (theme.favicon.ico) { %>
      <link rel="icon" type="image/x-icon" href="<%- url_for(theme.favicon.ico) %>">
    <% } %>
    <% if (theme.favicon.small) { %>
      <link rel="icon" type="image/png" sizes="16x16" href="<%- url_for(theme.favicon.small) %>">
    <% } %>
    <% if (theme.favicon.medium) { %>
      <link rel="icon" type="image/png" sizes="32x32" href="<%- url_for(theme.favicon.medium) %>">
    <% } %>
    <% if (theme.favicon.large) { %>
      <link rel="icon" type="image/png" sizes="192x192" href="<%- url_for(theme.favicon.large) %>">
    <% } %>
    <% if (theme.favicon.apple_touch_icon) { %>
      <link rel="apple-touch-icon" sizes="180x180" href="<%- url_for(theme.favicon.apple_touch_icon) %>">
    <% } %>
  <% } %>
  <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="<%- url_for('css/theme-colors.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/main.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/style.css') %>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- 添加代码高亮样式 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/atom-one-dark.min.css">
  <!-- 添加highlight.js库 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>
  <!-- 添加mermaid.js库 -->
  <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
  <link rel="stylesheet" href="<%- url_for('css/code.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/code-custom.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/code-languages.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/mermaid.css') %>">

  <link rel="stylesheet" href="<%- url_for('css/vs-code.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/post.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/tag.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/categories.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/archive.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/search.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/mobile.css') %>">  <link rel="stylesheet" href="<%- url_for('css/responsive.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/elements.css') %>">

  <!-- 添加 JetBrains Mono 字体 -->
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

  <%- partial('_partial/custom_head') %>
  <script src="<%- url_for('js/explorer.js') %>"></script>
  <script src="<%- url_for('js/code-copy.js') %>"></script>
  <script src="<%- url_for('js/code-enhance.js') %>"></script>
</head>
