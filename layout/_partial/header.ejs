<header class="vs-header">
  <nav class="vs-nav">
    <div class="nav-left">
      <a href="<%- config.root %>" class="nav-brand">
        <i class="fas fa-terminal"></i>
        <%= config.title %>
      </a>
    </div>

    <div class="nav-right">
      <!-- Desktop Navigation -->
      <div class="desktop-nav">
        <a href="<%- config.root %>" class="nav-item <%= is_home() ? 'active' : '' %>">
          <i class="fas fa-home"></i>
          <span><%- __('home') %></span>
        </a>
        <a href="<%- config.root + 'archives/' %>" class="nav-item <%= is_archive() ? 'active' : '' %>">
          <i class="fas fa-archive"></i>
          <span><%- __('archives') %></span>
        </a>
        <a href="<%- config.root + 'categories/' %>" class="nav-item <%= is_category() ? 'active' : '' %>">
          <i class="fas fa-folder"></i>
          <span><%- __('categories') %></span>
        </a>
        <a href="<%- config.root + 'tags/' %>" class="nav-item <%= is_tag() ? 'active' : '' %>">
          <i class="fas fa-tags"></i>
          <span><%- __('tags') %></span>
        </a>
        <a href="<%- config.root + 'search/' %>" class="nav-item <%= is_current('search') ? 'active' : '' %>">
          <i class="fas fa-search"></i>
          <span><%- __('search') %></span>
        </a>
        <% if (theme.fixed_pages && theme.fixed_pages.length) { %>
          <% theme.fixed_pages.filter(item => item.header).forEach(function(item) { %>
            <a href="<%- url_for(item.path) %>" class="nav-item <%= is_current(item.path.replace(/^\//, '').replace(/\/$/, '')) ? 'active' : '' %>">
              <i class="<%- item.icon || 'fas fa-file-alt' %>"></i>
              <span><%- item.title %></span>
            </a>
          <% }) %>
        <% } %>
      </div>

      <!-- Mobile Menu Toggle -->
      <button class="mobile-menu-btn">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu-dropdown">
    <div class="mobile-nav-links">
      <a href="<%- config.root %>" class="mobile-nav-item <%= is_home() ? 'active' : '' %>">
        <i class="fas fa-home"></i>
        <span><%- __('home') %></span>
      </a>
      <a href="<%- config.root + 'archives/' %>" class="mobile-nav-item <%= is_archive() ? 'active' : '' %>">
        <i class="fas fa-archive"></i>
        <span><%- __('archives') %></span>
      </a>
      <a href="<%- config.root + 'categories/' %>" class="mobile-nav-item <%= is_category() ? 'active' : '' %>">
        <i class="fas fa-folder"></i>
        <span><%- __('categories') %></span>
      </a>
      <a href="<%- config.root + 'tags/' %>" class="mobile-nav-item <%= is_tag() ? 'active' : '' %>">
        <i class="fas fa-tags"></i>
        <span><%- __('tags') %></span>
      </a>
      <a href="<%- config.root + 'search/' %>" class="mobile-nav-item <%= is_current('search') ? 'active' : '' %>">
        <i class="fas fa-search"></i>
        <span><%- __('search') %></span>
      </a>
      <% if (theme.fixed_pages && theme.fixed_pages.length) { %>
        <% theme.fixed_pages.filter(item => item.header).forEach(function(item) { %>
          <a href="<%- url_for(item.path) %>" class="mobile-nav-item <%= is_current(item.path.replace(/^\//, '').replace(/\/$/, '')) ? 'active' : '' %>">
            <i class="<%- item.icon || 'fas fa-file-alt' %>"></i>
            <span><%- item.title %></span>
          </a>
        <% }) %>
      <% } %>
    </div>

    <!-- Mobile TOC Section (Only shown on post pages) -->
    <% if (is_post()) { %>
    <div class="mobile-toc-section">
      <div class="mobile-toc-header">
        <i class="fas fa-list"></i>
        <span>TABLE OF CONTENTS</span>
      </div>
      <div class="mobile-toc-content">
        <%- toc(page.content, {list_number: false}) %>
      </div>
    </div>
    <% } %>
  </div>
</header>

<script>
  // Smooth scroll function
  function smoothScroll(event, target) {
    event.preventDefault();
    const targetId = target.substring(target.indexOf('#') + 1);
    const targetElement = document.getElementById(targetId);

    if (targetElement) {
      // Close mobile menu if open
      document.querySelector('.mobile-menu-dropdown').classList.remove('show');

      const headerOffset = 60; // Adjust based on header height
      const elementPosition = targetElement.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: "smooth"
      });
    } else {
      window.location.href = target;
    }
  }

  // Header scroll effect
  window.addEventListener('scroll', function() {
    const header = document.querySelector('.vs-header');
    const nav = document.querySelector('.vs-nav');
    const scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;

    nav.style.setProperty('--scroll-percent', `${scrollPercent}%`);

    if (window.scrollY > 0) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });

  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const menuBtn = document.querySelector('.mobile-menu-btn');
    const dropdown = document.querySelector('.mobile-menu-dropdown');

    if(menuBtn) {
      menuBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdown.classList.toggle('show');
      });

      // Close menu when clicking outside
      document.addEventListener('click', function(e) {
        if (!dropdown.contains(e.target) && !menuBtn.contains(e.target)) {
          dropdown.classList.remove('show');
        }
      });
    }

    // Add ripple effect to desktop nav items
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', function(e) {
        const ripple = document.createElement('span');
        ripple.classList.add('nav-ripple');
        this.appendChild(ripple);

        const rect = this.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        ripple.style.left = `${x}px`;
        ripple.style.top = `${y}px`;

        setTimeout(() => ripple.remove(), 1000);
      });
    });
  });
</script>
